# Copy to .env for local development. Replace both local passwords before starting Compose.
SERVER_PORT=8080

# Local PostgreSQL container
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=timesync_db
POSTGRES_USER=timesync_user
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# Local Redis container
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-different-local-password

# Backend provider credentials. Never use VITE_ prefixes for these.
YOUTUBE_API_KEY=replace-with-youtube-data-api-key
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_COMPLETIONS_PATH=/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Browser access and public share links
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_BASE_URL=http://localhost:5173

# Anonymous API limits
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=200
TRUST_FORWARDED_HEADERS=false

# AI capacity and timeouts
GEMINI_DAILY_REQUEST_BUDGET=15
GEMINI_WORKER_THREADS=1
GEMINI_JOB_WORKER_THREADS=1
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_VERIFICATION_TIMEOUT_SECONDS=20
GEMINI_VERIFICATION_FALLBACK_TIMEOUT_SECONDS=8
GEMINI_PROCESSING_TIMEOUT_SECONDS=300
AI_RETRY_MAX_ATTEMPTS=1
AI_RETRY_INITIAL_DELAY_MS=1000
AI_RETRY_MAX_DELAY_MS=5000

# Playlist capacity
MAX_PLAYLIST_VIDEOS=250
PLAYLIST_BATCH_SIZE=8
PLAYLIST_WORKER_THREADS=6
PLAYLIST_BATCH_TIMEOUT_SECONDS=900

# YouTube retry and resilience
YOUTUBE_RETRY_MAX_ATTEMPTS=2
YOUTUBE_RETRY_INITIAL_DELAY_MS=1000
YOUTUBE_RETRY_MULTIPLIER=2.0
YOUTUBE_RETRY_MAX_DELAY_MS=8000
YOUTUBE_INITIAL_COOLDOWN_SECONDS=60
YOUTUBE_MAXIMUM_COOLDOWN_SECONDS=600
YOUTUBE_DATA_API_INITIAL_COOLDOWN_SECONDS=60
YOUTUBE_DATA_API_MAXIMUM_COOLDOWN_SECONDS=600
YOUTUBE_CONTENT_INITIAL_COOLDOWN_SECONDS=60
YOUTUBE_CONTENT_MAXIMUM_COOLDOWN_SECONDS=600
YOUTUBE_MAX_CONCURRENT_REQUESTS=3
YOUTUBE_PERMIT_WAIT_TIMEOUT_MS=5000

# Shared cache lifetimes
TRANSCRIPT_NOTES_CACHE_TTL_SECONDS=604800
YOUTUBE_PLAYER_RESPONSES_CACHE_TTL_SECONDS=10800
AI_TRANSCRIPT_CHUNKS_CACHE_TTL_SECONDS=7200

# Shared-note lifetime
SHARE_TTL_HOURS=24
